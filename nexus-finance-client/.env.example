# ─── Nexus Finance Client — Environment Variables ─────────────────────────────
# Copy this file to .env for local development.
# On Vercel, add this as an Environment Variable in the project settings.

# The full URL of your backend API (your Render service URL + /api)
# Local development:
VITE_API_URL=http://localhost:5000/api

# Production (replace with your actual Render URL after deploying):
# VITE_API_URL=https://nexus-finance-server.onrender.com/api
